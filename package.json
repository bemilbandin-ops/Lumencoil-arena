{
  "name": "lumencoil-arena",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Server-authoritative multiplayer snake survival game",
  "scripts": {
    "dev": "node dist/server/index.js",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild": "npm run build && node dist/server/index.js",
    "test": "node tests/run.mjs && node tests/gameplay.mjs",
    "test:integration": "node tests/integration.mjs",
    "verify": "npm run build && npm test && npm run test:integration"
  },
  "engines": { "node": ">=20" },
  "devDependencies": { "typescript": "5.8.3" }
}
